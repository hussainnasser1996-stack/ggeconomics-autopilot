 "lines": [
  {
   "id": "hook",
   "text": "Starting Elden Ring? Do these three things in your first hour.",
   "start": 0.35,
   "end": 3.202
  },
  {
   "id": "one",
   "text": "One. Rest at a Site of Grace. Golden rays point to where you go next.",
   "start": 3.402,
   "end": 6.962
  },
  {
   "id": "two",
   "text": "Two. Find the merchant at the Church of Elleh, and buy the Crafting Kit.",
   "start": 7.162,
   "end": 10.303
  },
  {
   "id": "three",
   "text": "Three. Keep your Stonesword Keys. They open the imp-statue seals.",
   "start": 10.502,
   "end": 13.788
  },
  {
   "id": "out",
   "text": "That's your first hour. Save your game.",
   "start": 13.988,
   "end": 15.802
  }
 ],
