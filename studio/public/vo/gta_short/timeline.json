 "lines": [
  {
   "id": "hook",
   "text": "GTA Six isn't even out yet. And it's already made a billion dollars.",
   "start": 0.35,
   "end": 4.213
  },
  {
   "id": "pre",
   "text": "That's the estimate from Sensor Tower, for digital pre-orders alone. Take-Two hasn't confirmed it.",
   "start": 4.393,
   "end": 9.453
  },
  {
   "id": "price",
   "text": "The price? Eighty dollars. The Ultimate Edition, a hundred.",
   "start": 9.633,
   "end": 12.641
  },
  {
   "id": "bet",
   "text": "And Take-Two needs it. Last quarter, bookings fell eighteen percent.",
   "start": 12.821,
   "end": 16.177
  },
  {
   "id": "guide",
   "text": "This quarter, they're guiding three point three five to three point five billion. More than double.",
   "start": 16.357,
   "end": 20.938
  },
  {
   "id": "quote",
   "text": "Even the CEO is careful. Quote: we tend to avoid claiming success before it occurs.",
   "start": 21.118,
   "end": 25.743
  },
  {
   "id": "out",
   "text": "November nineteenth. Save your game.",
   "start": 25.923,
   "end": 27.783
  }
 ],
