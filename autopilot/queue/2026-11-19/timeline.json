 "lines": [
  {
   "id": "hook",
   "text": "GTA 6 is out, and your console runs it at 30 frames.",
   "start": 0.35,
   "end": 3.33
  },
  {
   "id": "all",
   "text": "Rockstar targets 30 frames a second on PS5 and on Xbox Series X and S.",
   "start": 3.45,
   "end": 7.732
  },
  {
   "id": "pro",
   "text": "There's no 60 frames mode at launch, not even on a PS5 Pro.",
   "start": 7.852,
   "end": 11.155
  },
  {
   "id": "extra",
   "text": "The Pro gets sharper upscaling, called PSSR, plus ray-traced shadows no other console gets.",
   "start": 11.275,
   "end": 15.976
  },
  {
   "id": "buy",
   "text": "So if you're eyeing a Pro tonight, you're paying for looks, not smoothness.",
   "start": 16.096,
   "end": 18.811
  },
  {
   "id": "out",
   "text": "That's the game. GG.",
   "start": 18.931,
   "end": 20.198
  }
 ],
