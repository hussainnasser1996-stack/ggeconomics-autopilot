  {
   "id": "hook",
   "text": "GTA Six unlocks tonight, and you need 212 gigs free.",
   "start": 0.35,
   "end": 3.596
  },
  {
   "id": "size",
   "text": "Rockstar says the download takes up to 212 gigabytes, depending on your console.",
   "start": 3.716,
   "end": 7.854
  },
  {
   "id": "load",
   "text": "Pre-load has been open since November tenth, so start it now, not at midnight.",
