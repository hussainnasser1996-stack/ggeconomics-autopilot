   "end": 11.496
  },
  {
   "id": "disc",
   "text": "Bought the disc? It's a code in a box, so you still download it.",
   "start": 11.616,
   "end": 14.113
  },
  {
   "id": "cloud",
   "text": "No room on Xbox? Cloud streaming starts at 1 AM Eastern, nothing to install, but you need Game Pass or paid cloud time.",
   "start": 14.233,
   "end": 19.989
  },
  {
   "id": "out",
   "text": "That's the game. GG.",
   "start": 20.109,
   "end": 21.377
  }
